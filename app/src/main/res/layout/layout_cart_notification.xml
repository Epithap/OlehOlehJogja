<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCartNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="70dp"
    android:visibility="gone"
    app:cardBackgroundColor="@color/sogan"
    app:cardCornerRadius="14dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/gold"
    app:strokeWidth="1.2dp"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Souvenir Thumbnail with check badge -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivToastThumb"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
                tools:src="@drawable/img_bakpia" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle_rank"
                android:contentDescription="Check"
                android:padding="2dp"
                android:src="@drawable/ic_check"
                app:tint="@color/sogan" />
        </FrameLayout>

        <!-- Message Texts -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvToastTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                android:textStyle="bold"
                tools:text="Bakpia Pathok" />

            <TextView
                android:id="@+id/tvToastSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/gold_light"
                android:textSize="10.5sp"
                tools:text="Berhasil ditambahkan ke keranjang" />
        </LinearLayout>

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToastOpenCart"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/gold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="Lihat"
            android:textColor="@color/sogan"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
